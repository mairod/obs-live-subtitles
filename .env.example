# ElevenLabs — required (Scribe v2 Realtime STT)
ELEVENLABS_API_KEY=

# Translation — set ONE of these two keys (or both + TRANSLATOR to choose)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides
# SCRIBE_LANGUAGE=fr           # default fr; set EMPTY for auto-detect (worse accuracy)
# SCRIBE_SECONDARY_LANGUAGES=en  # untested: primary fr + allowed extras
# VAD_SILENCE_SECS=0.4         # shorter silence = shorter, faster phrases
# TRANSLATOR=openai            # or: anthropic
# OPENAI_MODEL=gpt-4.1-mini    # faster/weaker: gpt-4.1-nano
# ANTHROPIC_MODEL=claude-haiku-4-5   # slower/stronger: claude-sonnet-4-6
# PORT=3000
